# Copy to .env.local for local overrides. Never put secrets here — credentials live in Windows Credential Manager.

# Rust log filter (tracing EnvFilter syntax).
RUST_LOG=info,notch_desktop_lib=debug

# Dev builds only: comma-separated modules to back with mock adapters (media,calendar,git,claude).
# Mock data is always badged "MOCK" in the UI and is compiled out of release builds.
NOTCH_MOCK=
